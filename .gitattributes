# Left out of the release downloads (scripts/package.js uses git archive).
.github export-ignore
.gitattributes export-ignore
# Keep shell scripts working when the repo is checked out on Windows.
*.sh text eol=lf
install.sh text eol=lf
# The desktop app's own files aren't needed by the one-command install.
electron export-ignore
build export-ignore
electron-builder.yml export-ignore
docs/screenshots export-ignore
CONTRIBUTING.md export-ignore
CODE_OF_CONDUCT.md export-ignore
SECURITY.md export-ignore
